# Supabase (Project Settings -> API Keys)
# New projects show "Publishable key" (sb_publishable_...) and "Secret key" (sb_secret_...).
# Older projects show "anon" and "service_role" (eyJ...). Either style works.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Stripe (Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Where the app is hosted (no trailing slash). Used for portal links and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
